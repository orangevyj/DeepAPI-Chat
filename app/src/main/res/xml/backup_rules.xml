<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API < 31.

   The API key is stored in plaintext inside filesDir/data/settings.json, so that
   file is deliberately excluded from cloud backups. Attachments are excluded
   because photos blow through the 25 MB Auto Backup quota very quickly.

   Conversations and memories are intentionally still backed up.
-->
<full-backup-content>
    <exclude domain="file" path="data/settings.json" />
    <exclude domain="file" path="data/attachments" />
</full-backup-content>
